{
  "name": "samples-embed-control",
  "private": true,
  "description": "Samples of @abap2ui5/embed-control: a UI5 freestyle app, Fiori elements apps for OData V4 and V2 (with the RAP service the latter reads) and a UI Integration Card, each running abap2UI5 apps in the control from npm",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "freestyle",
    "fiori-elements",
    "fiori-elements-v2",
    "card"
  ],
  "scripts": {
    "start": "npm run start --workspace freestyle",
    "start:fe": "npm run start --workspace fiori-elements",
    "start:card": "npm run start --workspace card",
    "start:fe-v2": "npm run start --workspace fiori-elements-v2",
    "start-local": "npm run start-local --workspace freestyle",
    "start-local:fe": "npm run start-local --workspace fiori-elements",
    "start-local:card": "npm run start-local --workspace card",
    "start-local:fe-v2": "npm run start-local --workspace fiori-elements-v2",
    "build": "npm run build --workspaces",
    "bsp": "node scripts/build-bsp.mjs",
    "e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,mjs,json}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,json}\"",
    "abaplint": "abaplint abaplint.jsonc"
  },
  "devDependencies": {
    "@abaplint/cli": "^2.120.75",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@ui5/cli": "^4.0.71",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
